# Copied to deploy.local.env (untracked) and filled in per host. Read by deploy/setup.sh and deploy/deploy.sh.

# The public name nginx serves the site at. Blank: setup.sh only makes the web root.
SITE_HOST=

# Where the build lands. Defaults to /srv/<project>.
# SITE_WEBROOT=

# Written into config.json beside the build on every deploy.
SITE_API=
SITE_ISSUER=
SITE_CLIENT_ID=
