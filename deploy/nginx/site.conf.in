# The site, served as static files. Rendered by deploy/setup.sh into /etc/nginx/conf.d/.
#
# Nothing is proxied: the site calls its API and its sign-in anchor at their own addresses.

# What a browser may keep: the content-hashed assets for good, everything else checked each time, so
# an installed app never stays pinned to an old build.
map $uri $@PROJECT@_cache {
    ~^/assets/  "public, max-age=31536000, immutable";
    default     "no-cache";
}

server {
    listen      443 ssl;
    listen      [::]:443 ssl;
    http2       on;
    server_name @SITE_HOST@;

    ssl_certificate     /etc/letsencrypt/live/@SITE_HOST@/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/@SITE_HOST@/privkey.pem;

    root  @WEBROOT@;
    index index.html;

    add_header Cache-Control           $@PROJECT@_cache always;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options  "nosniff" always;
    add_header Referrer-Policy         "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy      "camera=(), geolocation=(), payment=()" always;
    # Scripts and styles come from this origin alone; data goes to any https address, since the API's
    # and the anchor's are named in config.json rather than here.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https:; worker-src 'self'; manifest-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;

    # Real paths: every route is index.html, and the router draws it. The sign-in callback is one of them.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # A missing asset is a 404, not the page: a browser asking for an old build's file must learn it is gone.
    location /assets/ {
        try_files $uri =404;
    }
}
